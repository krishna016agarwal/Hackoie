GITHUB_TOKEN=

# Email / OTP
MAILTRAP_SMTP_HOST=
MAILTRAP_SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Deployment hint (optional)
VERCEL=
