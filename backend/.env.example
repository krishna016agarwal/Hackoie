# Core
PORT=3000
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=replace_with_strong_secret
MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# AI Matching
GEMINI_API_KEY=

# GitHub Skill Proofread (optional but recommended)
